{
  "author": "Stanley Masinde <hello@stanleymasinde.com> (https://stanleymasinde.github.io)",
  "bugs": {
    "email": "stanleymasinde1@gmail.com",
    "url": "https://github.com/StanleyMasinde/mevn-orm/issues"
  },
  "contributors": [
    {
      "email": "hello@stanleymasinde.com",
      "name": "Stanley Masinde"
    }
  ],
  "dependencies": {
    "pluralize": "^8.0.0"
  },
  "description": "simple ORM for express js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^25.9.8",
    "@typescript-eslint/parser": "^8.70.1",
    "better-sqlite3": "^13.0.3",
    "db0": "^0.4.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "directories": {
    "test": "test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db0": {
      "types": "./dist/db0.d.ts",
      "import": "./dist/db0.js",
      "default": "./dist/db0.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://stanleymasinde.github.io/mevn-orm/",
  "keywords": [
    "ORM",
    "express",
    "Mysql",
    "mevn",
    "database",
    "orm",
    "orm-express",
    "orm-mysql"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "mevn-orm",
  "packageManager": "pnpm@12.6.0",
  "peerDependencies": {
    "db0": "^0.4.0",
    "knex": "^3.0.0",
    "mysql2": "^3.9.3"
  },
  "peerDependenciesMeta": {
    "db0": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanleyMasinde/mevn-orm.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "init:db": "node --import tsx initDb.ts",
    "lint": "eslint .",
    "migrate": "node --import tsx scripts/migrate.ts latest",
    "migrate:list": "node --import tsx scripts/migrate.ts list",
    "migrate:make": "node --import tsx scripts/migrate.ts make",
    "migrate:rollback": "node --import tsx scripts/migrate.ts rollback",
    "migrate:version": "node --import tsx scripts/migrate.ts version",
    "prepack": "pnpm run build",
    "pretest": "node --import tsx initDb.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "4.8.0"
}
